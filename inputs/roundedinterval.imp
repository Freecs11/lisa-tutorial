class roundedinterval {
    // Basic arithmetic operations with rounding to different precisions
    basicRounding() {
        def a = 2.5;
        def b = 3.33333;
        def c = 1.999;
        
        // Test addition with rounding
        def sum = a + b; // Should be rounded to 5.83 with default precision=2
        
        // Test multiplication with rounding
        def prod = a * c; // Should be rounded to 5.0 with default precision=2
        
        // Test subtraction with rounding
        def diff = b - a; // Should be rounded to 0.83 with default precision=2
        
        // Test division with rounding
        def div = b / a; // Should be rounded to 1.33 with default precision=2
        
        return sum;
    }
    
    // Test loop with widening and rounding
    loopRounding() {
        def count = 0;
        def sum = 0.0;
        
        while (count < 10) {
            count = count + 1;
            sum = sum + 1.34567;  // With precision=2, should accumulate by 1.35 each time
        }
        
        return sum;
    }
    
    // Test branch conditions with rounded values
    branchRounding(x, y) {
        def result = 0;
        
        // Division often creates non-integer results requiring rounding
        def ratio = x / y;
        
        if (ratio > 2.5) {
            result = ratio * 10;
        } else {
            result = ratio + 5;
        }
        
        return result;
    }
    
    // Test precision handling with very small numbers
    smallNumbers() {
        def a = 0.0001234;
        def b = 0.0005678;
        
        // With precision=2, these would both be 0.00
        // With precision=4, they would be 0.0001 and 0.0006
        def sum = a + b;  // With precision=4, should be 0.0007
        
        return sum;
    }
    

}